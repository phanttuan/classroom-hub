# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG (.env) - CHUẨN ENTERPRISE & SCALABLE
# ==============================================================================
# 1. Tạo bản sao của file này và đặt tên là `.env` (nằm cùng thư mục với package.json)
# 2. Điền các thông số thực tế của bạn bên dưới.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH ỨNG DỤNG (APPLICATION CONFIG)
# ------------------------------------------------------------------------------
# Môi trường chạy: development | production | test
NODE_ENV=development

# Cổng chạy ứng dụng Backend (mặc định khuyến nghị: 5000 để tránh trùng cổng 3000 của Next.js frontend)
PORT=5000

# Tiền tố đường dẫn API (Version API)
API_PREFIX=api/v1

# Danh sách các domain Frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DATABASE POSTGRESQL
# Hệ thống hỗ trợ 2 cách cấu hình (Ưu tiên Cách 1 nếu cả 2 đều được khai báo):
# ------------------------------------------------------------------------------

# CÁCH 1: DÙNG CHUỖI KẾT NỐI DUY NHẤT (DATABASE_URL)
# Thường được cấp bởi các dịch vụ Cloud như Supabase, Neon.tech, Render, Railway, v.v.
# Cú pháp: postgresql://<username>:<password>@<host>:<port>/<database_name>?sslmode=<require/disable>
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/classroom_hub?sslmode=disable

# CÁCH 2: DÙNG CÁC BIẾN RIÊNG LẺ (Phổ biến trên máy cá nhân hoặc Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_DATABASE=classroom_hub

# Chế độ mã hóa SSL (false: localhost, true: Supabase/Neon/Render/AWS RDS)
DB_SSL=false

# Tự động đồng bộ Schema bảng dữ liệu (true / false)
# LƯU Ý BẢO MẬT: Trong code đã cấu hình tự động tắt trên production để tránh mất dữ liệu!
DB_SYNCHRONIZE=true

# Ghi log các câu lệnh SQL thực thi ra console (true / false)
DB_LOGGING=false

# ------------------------------------------------------------------------------
# 3. TỐI ƯU HÓA HIỆU NĂNG & CONNECTION POOLING (CHỊU TẢI CAO)
# ------------------------------------------------------------------------------
# Số lượng kết nối tối đa trong Pool (Khuyến nghị: 10 - 50 tùy cấu hình server)
DB_POOL_MAX=20

# Số lượng kết nối tối thiểu luôn giữ sẵn sàng trong Pool
DB_POOL_MIN=2

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# 4. CẤU HÌNH BẢO MẬT JWT AUTH (XÁC THỰC PHIÊN ĐĂNG NHẬP)
# ------------------------------------------------------------------------------
# Khóa bí mật ký Access Token (Tối thiểu 32 ký tự ngẫu nhiên bảo mật cao)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
# Thời hạn hiệu lực của Access Token (Ví dụ: 15m, 1h)
JWT_EXPIRES_IN=15m

# Khóa bí mật ký Refresh Token
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
# Thời hạn hiệu lực của Refresh Token (Ví dụ: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH DỊCH VỤ GỬI EMAIL OTP QUA RESEND (RESEND EMAIL SERVICE)
# ------------------------------------------------------------------------------
# Khóa API Resend (Lấy miễn phí tại https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Địa chỉ người gửi (VD: EduHub <onboarding@resend.dev> hoặc domain riêng đã xác thực)
EMAIL_FROM="EduHub <thaytenvaoday@tenmien.blabla>"

# Đường dẫn URL logo EduHub hiển thị trên email (Tùy chọn, mặc định dùng CDN chính thức)
APP_LOGO_URL=https://files.catbox.moe/27b245.png

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH XÁC THỰC GOOGLE OAUTH 2.0 (GOOGLE SIGN-IN)
# ------------------------------------------------------------------------------
# Lấy tại Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret



# ------------------------------------------------------------------------------
# 7. LƯU TRỮ TÀI LIỆU & MEDIA — CLOUDINARY
# ------------------------------------------------------------------------------
# Lấy tại https://console.cloudinary.com → Settings → API Keys (gói Free là đủ dùng)
# Chưa điền: xem/tải tài liệu seed sẽ lỗi, upload báo "Chưa cấu hình Cloudinary"
#
# Quy ước lưu trữ (Resource.storageKey = "<resource_type>:<public_id>"):
#  - Tài liệu bài học: riêng tư (delivery type "authenticated"), chỉ xem qua signed URL có hạn
#      classroom-hub/lessons/<courseId>/<lessonId>/<thời gian>-<mã>-<tên-tệp>
#  - Ảnh chèn trong nội dung trang: công khai
#      classroom-hub/content-images/<courseId>/<thời gian>-<mã>-<tên-ảnh>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Dung lượng tối đa mỗi tệp tải lên (MB). Gói Free của Cloudinary giới hạn 10MB / ảnh-tài liệu, 100MB / video
UPLOAD_MAX_FILE_MB=10
